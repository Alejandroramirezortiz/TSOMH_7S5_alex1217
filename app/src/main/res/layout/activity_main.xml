<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nombre de la institución -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TECNOLÓGICO DE ESTUDIOS\nSUPERIORES DEL ESTADO DE\nMÉXICO"
            android:textAlignment="center"
            android:textColor="#4CAF50"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="35dp" />

        <!-- Alumno -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alumno: Alejandro Rmirez Ortiz"
            android:textAlignment="center"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <!-- Materia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tópicos Selectos de\nDispositivos Móviles Híbridos"
            android:textAlignment="center"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <!-- Grupo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grupo: 7S5"
            android:textAlignment="center"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <!-- Profesor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profesor: Víctor Hugo de la O\nMartínez"
            android:textAlignment="center"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="35dp" />

        <!-- Imagen temporal -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Imagen del alumno"
            android:scaleType="centerCrop" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>